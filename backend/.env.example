
# VisionQA Backend Environment Variables (Example)

# Database
DATABASE_URL=postgresql://visionqa:visionqa_password@localhost:5432/visionqa_db

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Platform Settings
DEBUG=True

# 🤖 AI Models
# SAM3 is a gated Hugging Face model. Do not commit real tokens.
HF_TOKEN=hf_your_token_here
SAM3_MODEL_ID=facebook/sam3
VISION_MODEL_PROVIDER=sam3
VISION_MODEL_FALLBACK=dinox
DINO_MODEL_ID=IDEA-Research/grounding-dino-base
LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
